{
  "info": {
    "_postman_id": "00000001-shared-service-emprendia-0002",
    "name": "01 – Shared Service (Puerto 8084)",
    "description": "Catálogos compartidos de la plataforma Emprendia.\n\nReglas de acceso:\n- GET catalogue-types/** y catalogue-values/** → PÚBLICO (sin token)\n- POST / PUT / DELETE → requiere ROLE_ADMIN\n\nBase URL: {{shared_url}} = http://localhost:8084",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-fetch token si está vacío",
          "const token = pm.environment.get('access_token');",
          "if (!token) {",
          "    const keycloakUrl = pm.environment.get('keycloak_url');",
          "    const realm      = pm.environment.get('keycloak_realm');",
          "    const clientId   = pm.environment.get('keycloak_client_id');",
          "    const username   = pm.environment.get('keycloak_username');",
          "    const password   = pm.environment.get('keycloak_password');",
          "    pm.sendRequest({",
          "        url: `${keycloakUrl}/realms/${realm}/protocol/openid-connect/token`,",
          "        method: 'POST',",
          "        header: { 'Content-Type': 'application/x-www-form-urlencoded' },",
          "        body: {",
          "            mode: 'urlencoded',",
          "            urlencoded: [",
          "                { key: 'grant_type', value: 'password' },",
          "                { key: 'client_id',  value: clientId  },",
          "                { key: 'username',   value: username  },",
          "                { key: 'password',   value: password  }",
          "            ]",
          "        }",
          "    }, (err, res) => {",
          "        if (!err && res.code === 200) {",
          "            pm.environment.set('access_token', res.json().access_token);",
          "            console.log('🔑 Token auto-obtenido para Shared Service');",
          "        } else {",
          "            console.error('❌ No se pudo obtener el token automáticamente. Ejecuta primero 00-Auth-Keycloak > Login.');",
          "        }",
          "    });",
          "}"
        ]
      }
    }
  ],
