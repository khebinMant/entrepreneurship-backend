{
  "info": {
    "_postman_id": "00000003-entrepreneurship-service-0004",
    "name": "03 – Entrepreneurship Service (Puerto 8082)",
    "description": "Gestión de emprendimientos en la plataforma Emprendia.\n\nTodos los endpoints requieren JWT válido.\n\nBase URL: {{entrepreneurship_url}} = http://localhost:8082\n\nCampos del body (EntrepreneurshipRequest):\n- userId (Long, requerido): ID del dueño (tabla app_user)\n- categoryId (Long, requerido): ID del CatalogueValue con código de categoría\n- name (String, max 150, requerido): Nombre del emprendimiento\n- description (String, opcional): Descripción\n- logoUrl (String, opcional): URL del logo\n- isPhysical (Boolean, requerido): Tiene presencia física\n- isDigital (Boolean, requerido): Opera en forma digital\n- socialLinks (Array<SocialLinkItem>, opcional): Redes sociales\f    · socialPlatformId (Long): ID del catálogo de plataforma social (ej: 89=Facebook, 90=Instagram, 91=WhatsApp)\f    · url (String): URL completa del perfil\f- locations (Array<LocationItem>, opcional): Ubicaciones físicas\f    · countryId (Long, requerido): ID del país\f    · provinceId (Long, requerido): ID de la provincia\f    · cityId (Long, requerido): ID de la ciudad\f    · parishId (Long, opcional): ID de la parroquia\f    · addressLine (String, opcional): Dirección textual\f    · latitude (Decimal, opcional): Latitud GPS\f    · longitude (Decimal, opcional): Longitud GPS\f    · mapsUrl (String, opcional): URL de Google Maps para la ubicación\f- portal (PortalItem, opcional): Portal web del emprendimiento\f    · subdomain (String, requerido, único): Subdominio del portal\f    · themeId (Long, requerido): ID del tema visual\f    · isActive (Boolean, opcional, default true): Activo/inactivo\f    · htmlContent (String, opcional): HTML personalizado del portal",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const token = pm.environment.get('access_token');",
          "if (!token) {",
          "    const keycloakUrl = pm.environment.get('keycloak_url');",
          "    const realm      = pm.environment.get('keycloak_realm');",
          "    const clientId   = pm.environment.get('keycloak_client_id');",
          "    const username   = pm.environment.get('keycloak_username');",
          "    const password   = pm.environment.get('keycloak_password');",
          "    pm.sendRequest({",
          "        url: `${keycloakUrl}/realms/${realm}/protocol/openid-connect/token`,",
          "        method: 'POST',",
          "        header: { 'Content-Type': 'application/x-www-form-urlencoded' },",
          "        body: {",
          "            mode: 'urlencoded',",
          "            urlencoded: [",
          "                { key: 'grant_type', value: 'password' },",
          "                { key: 'client_id',  value: clientId  },",
          "                { key: 'username',   value: username  },",
          "                { key: 'password',   value: password  }",
          "            ]",
          "        }",
          "    }, (err, res) => {",
          "        if (!err && res.code === 200) {",
          "            pm.environment.set('access_token', res.json().access_token);",
          "            console.log('🔑 Token auto-obtenido para Entrepreneurship Service');",
          "        } else {",
          "            console.error('❌ No se pudo obtener el token. Ejecuta primero 00-Auth-Keycloak > Login.');",
          "        }",
          "    });",
          "}"
        ]
      }
    }
  ],
