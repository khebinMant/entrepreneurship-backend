{
  "info": {
    "_postman_id": "00000002-user-service-emprendia-0003",
    "name": "02 – User Service (Puerto 8081)",
    "description": "Gestión de usuarios de la plataforma Emprendia.\n\nTodos los endpoints requieren JWT válido (Bearer {{access_token}}).\n\nBase URL: {{user_url}} = http://localhost:8081\n\nCampos del body:\n- keycloakId (String): ID del usuario en Keycloak (claim 'sub' del JWT)\n- firstName (String): Nombre\n- lastName (String): Apellido\n- profilePictureUrl (String, opcional): URL de foto de perfil",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-fetch token si está vacío",
          "const token = pm.environment.get('access_token');",
          "if (!token) {",
          "    const keycloakUrl = pm.environment.get('keycloak_url');",
          "    const realm      = pm.environment.get('keycloak_realm');",
          "    const clientId   = pm.environment.get('keycloak_client_id');",
          "    const username   = pm.environment.get('keycloak_username');",
          "    const password   = pm.environment.get('keycloak_password');",
          "    pm.sendRequest({",
          "        url: `${keycloakUrl}/realms/${realm}/protocol/openid-connect/token`,",
          "        method: 'POST',",
          "        header: { 'Content-Type': 'application/x-www-form-urlencoded' },",
          "        body: {",
          "            mode: 'urlencoded',",
          "            urlencoded: [",
          "                { key: 'grant_type', value: 'password' },",
          "                { key: 'client_id',  value: clientId  },",
          "                { key: 'username',   value: username  },",
          "                { key: 'password',   value: password  }",
          "            ]",
          "        }",
          "    }, (err, res) => {",
          "        if (!err && res.code === 200) {",
          "            pm.environment.set('access_token', res.json().access_token);",
          "            console.log('🔑 Token auto-obtenido para User Service');",
          "        } else {",
          "            console.error('❌ No se pudo obtener el token. Ejecuta primero 00-Auth-Keycloak > Login.');",
          "        }",
          "    });",
          "}"
        ]
      }
    }
  ],
